<Window x:Class="FourteenPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FourteenPlayer"
        mc:Ignorable="d"
        Title="FourteenPlayer" Height="650" Width="450"
        Icon="app_icon.ico"
        MinHeight="520" MinWidth="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.ClearTypeHint="Enabled"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Realistic Slider Style with Instant Jump on Click -->
        <Style x:Key="ModernSlider" TargetType="{x:Type Slider}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#10B981"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <!-- Track Background Trench -->
                            <Border x:Name="TrackBackground" Height="6" CornerRadius="3" Background="#181C26" BorderBrush="#0D1017" BorderThickness="1" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.5" Direction="270" Color="#000000"/>
                                </Border.Effect>
                            </Border>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="6" CornerRadius="3" VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#059669" Offset="0.0"/>
                                                            <GradientStop Color="#10B981" Offset="0.8"/>
                                                            <GradientStop Color="#34D399" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Grid Width="16" Height="16" SnapsToDevicePixels="True">
                                                    <!-- Outer Metallic Bezel Ring -->
                                                    <Ellipse Fill="#2D3344" Stroke="#454F68" StrokeThickness="1">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.6" Color="#000000"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <!-- Inner Glowing Emerald Core -->
                                                    <Ellipse Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Ellipse.Fill>
                                                            <RadialGradientBrush GradientOrigin="0.4,0.4" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                                                <GradientStop Color="#A7F3D0" Offset="0.0"/>
                                                                <GradientStop Color="#10B981" Offset="0.7"/>
                                                                <GradientStop Color="#047857" Offset="1.0"/>
                                                            </RadialGradientBrush>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sharp Realistic Brushed Dark Titanium Control Button (Zero Blurriness!) -->
        <Style x:Key="RealisticCircleBtn" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid SnapsToDevicePixels="True">
                            <!-- Background Shadow Layer (Rendered separately so content is never blurred) -->
                            <Border CornerRadius="18" Margin="1" Background="#181C26">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1.5" Opacity="0.55" Color="#000000"/>
                                </Border.Effect>
                            </Border>

                            <!-- Sharp Foreground Layer with Subpixel Rendering -->
                            <Border x:Name="OuterBorder" CornerRadius="18" BorderThickness="1" BorderBrush="#3B4459" Margin="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2C3243" Offset="0.0"/>
                                        <GradientStop Color="#222735" Offset="0.45"/>
                                        <GradientStop Color="#181C26" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border x:Name="InnerBevel" CornerRadius="17" BorderThickness="1" BorderBrush="#1C202C" Margin="0">
                                    <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      SnapsToDevicePixels="True"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#525E7A"/>
                                <Setter TargetName="OuterBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#373E52" Offset="0.0"/>
                                            <GradientStop Color="#293041" Offset="0.5"/>
                                            <GradientStop Color="#1E2330" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="OuterBorder" Property="Margin" Value="1,2,1,0"/>
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#1C212D"/>
                                <Setter TargetName="OuterBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#151821" Offset="0.0"/>
                                            <GradientStop Color="#1C212E" Offset="0.6"/>
                                            <GradientStop Color="#252B3B" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sharp Realistic Toggle Button Style (Shuffle & Repeat) -->
        <Style x:Key="RealisticToggleBtn" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid SnapsToDevicePixels="True">
                            <!-- Background Shadow Layer -->
                            <Border CornerRadius="17" Margin="1" Background="#161923">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1.5" Opacity="0.5" Color="#000000"/>
                                </Border.Effect>
                            </Border>

                            <!-- Sharp Foreground Layer -->
                            <Border x:Name="OuterBorder" CornerRadius="17" BorderThickness="1" BorderBrush="#353D50" Margin="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#292F3E" Offset="0.0"/>
                                        <GradientStop Color="#1E2330" Offset="0.5"/>
                                        <GradientStop Color="#161923" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border x:Name="InnerBevel" CornerRadius="16" BorderThickness="1" BorderBrush="#1B1F2A">
                                    <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      SnapsToDevicePixels="True"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#10B981"/>
                                <Setter TargetName="OuterBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#143D30" Offset="0.0"/>
                                            <GradientStop Color="#0D2B22" Offset="0.5"/>
                                            <GradientStop Color="#071D16" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="#10B981"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#4C5770"/>
                                <Setter TargetName="OuterBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#333A4D" Offset="0.0"/>
                                            <GradientStop Color="#262C3C" Offset="0.5"/>
                                            <GradientStop Color="#1C212D" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="OuterBorder" Property="Margin" Value="1,2,1,0"/>
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#13161F"/>
                                <Setter TargetName="OuterBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#13161F" Offset="0.0"/>
                                            <GradientStop Color="#1A1E29" Offset="0.6"/>
                                            <GradientStop Color="#232837" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sharp Jewel Emerald Big Play/Pause Button (Ultra-Crisp Render) -->
        <Style x:Key="RealisticPlayBtn" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#091E16"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid SnapsToDevicePixels="True">
                            <!-- Outer Emerald Glow / Shadow Layer -->
                            <Border CornerRadius="24" Margin="1" Background="#10B981" Opacity="0.5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.55" Color="#10B981"/>
                                </Border.Effect>
                            </Border>

                            <!-- Sharp Metallic Rim Ring -->
                            <Border x:Name="OuterRim" CornerRadius="24" BorderThickness="1" BorderBrush="#3B465E" Margin="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2F3647" Offset="0.0"/>
                                        <GradientStop Color="#171A24" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <!-- Glowing Emerald Core -->
                                <Border x:Name="CoreBorder" CornerRadius="22" Margin="1" BorderThickness="1" BorderBrush="#6EE7B7">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#34D399" Offset="0.0"/>
                                            <GradientStop Color="#10B981" Offset="0.45"/>
                                            <GradientStop Color="#059669" Offset="0.85"/>
                                            <GradientStop Color="#047857" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      SnapsToDevicePixels="True"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CoreBorder" Property="BorderBrush" Value="#A7F3D0"/>
                                <Setter TargetName="CoreBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#6EE7B7" Offset="0.0"/>
                                            <GradientStop Color="#34D399" Offset="0.45"/>
                                            <GradientStop Color="#10B981" Offset="0.85"/>
                                            <GradientStop Color="#059669" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="OuterRim" Property="Margin" Value="1,2,1,0"/>
                                <Setter TargetName="CoreBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#047857" Offset="0.0"/>
                                            <GradientStop Color="#059669" Offset="0.5"/>
                                            <GradientStop Color="#064E3B" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sharp Realistic Tactile Flat/Pill Button Style -->
        <Style x:Key="RealisticFlatBtn" TargetType="{x:Type Button}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid SnapsToDevicePixels="True">
                            <!-- Background Shadow Layer -->
                            <Border CornerRadius="6" Background="#171A24">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1.5" Opacity="0.45" Color="#000000"/>
                                </Border.Effect>
                            </Border>

                            <!-- Sharp Content Layer -->
                            <Border x:Name="border" CornerRadius="6" BorderThickness="1" BorderBrush="#353E52" Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#272D3D" Offset="0.0"/>
                                        <GradientStop Color="#1E2330" Offset="0.5"/>
                                        <GradientStop Color="#171A24" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4F5D7B"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#333A4D" Offset="0.0"/>
                                            <GradientStop Color="#282F40" Offset="0.5"/>
                                            <GradientStop Color="#1F2432" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Margin" Value="0,1,0,0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#171B24"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#141720" Offset="0.0"/>
                                            <GradientStop Color="#1B202C" Offset="0.5"/>
                                            <GradientStop Color="#242A39" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window TitleBar Button Style -->
        <Style x:Key="TitleBarBtn" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5" Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252C3D"/>
                                <Setter Property="Foreground" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1F2C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleBarBtn" TargetType="{x:Type Button}" BasedOn="{StaticResource TitleBarBtn}">
            <Setter Property="Foreground" Value="#EF4444"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Clickable Version Badge Button -->
        <Style x:Key="VersionBadgeBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#1C2333"/>
            <Setter Property="BorderBrush" Value="#2D374E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#25324A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#10B981"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#151C28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Outer Container with Realistic Glass/Metal Depth -->
    <Border CornerRadius="14" Background="#0C0E14" BorderBrush="#252C3C" BorderThickness="1.2" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.65" Color="#000000"/>
        </Border.Effect>

        <Grid SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <!-- Row 0: Custom Header / Titlebar -->
                <RowDefinition Height="44"/>
                <!-- Row 1: Now Playing Card with Spectrum Visualizer -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Playlist & Search Toolbar -->
                <RowDefinition Height="Auto"/>
                <!-- Row 3: Playlist Items List -->
                <RowDefinition Height="*"/>
                <!-- Row 4: Bottom Realtime CPU & Status Bar -->
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- ================= ROW 0: CUSTOM TITLEBAR ================= -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="#131722">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo & App Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="20" Height="20" CornerRadius="4" ClipToBounds="True" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Image Source="app_icon.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="FourteenPlayer" FontWeight="Bold" FontSize="13.5" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                    <Button x:Name="BtnVersionBadge" Style="{StaticResource VersionBadgeBtn}" ToolTip="История версий (нажмите для просмотра)" Click="BtnVersionBadge_Click">
                        <TextBlock Text="v2.1.2" FontSize="9.5" Foreground="#10B981" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <!-- Settings Button -->
                    <Button x:Name="BtnSettings" Style="{StaticResource TitleBarBtn}" ToolTip="Настройки и О программе" Click="BtnSettings_Click">
                        <TextBlock Text="⚙" FontSize="13"/>
                    </Button>
                    <!-- Minimize Button -->
                    <Button Style="{StaticResource TitleBarBtn}" ToolTip="Свернуть в панель задач" Click="BtnMinimize_Click">
                        <TextBlock Text="—" FontSize="13" FontWeight="Bold"/>
                    </Button>
                    <!-- Close Button (Closes directly to System Tray!) -->
                    <Button Style="{StaticResource CloseTitleBarBtn}" ToolTip="Свернуть в трей (фоновое воспроизведение)" Click="BtnClose_Click">
                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= ROW 1: NOW PLAYING CARD ================= -->
            <Border Grid.Row="1" Margin="12,8,12,6" Background="#151924" CornerRadius="10" BorderBrush="#262D3E" BorderThickness="1" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Track Info -->
                        <RowDefinition Height="Auto"/> <!-- Seekbar -->
                        <RowDefinition Height="Auto"/> <!-- Playback Controls -->
                        <RowDefinition Height="Auto"/> <!-- Volume Bar -->
                    </Grid.RowDefinitions>

                    <!-- Track Info -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Album / App Icon Art with Metallic Bezel -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#1D2230" BorderBrush="#333C52" BorderThickness="1.2" ClipToBounds="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1.5" Opacity="0.4" Color="#000000"/>
                            </Border.Effect>
                            <Border CornerRadius="6" ClipToBounds="True" Margin="4">
                                <Image Source="app_icon.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </Border>

                        <!-- Title and Artist / Album -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock x:Name="TxtNowPlayingTitle" Text="Выберите трек для воспроизведения"
                                       FontWeight="Bold" FontSize="13.5" Foreground="#F9FAFB"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtNowPlayingArtist" Text="FourteenPlayer готов к работе"
                                       FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                    <!-- Seekbar Slider (Instant jump enabled) -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Slider x:Name="SeekSlider" Grid.Row="0" Style="{StaticResource ModernSlider}"
                                Minimum="0" Maximum="100" Value="0"
                                PreviewMouseDown="SeekSlider_PreviewMouseDown"
                                PreviewMouseUp="SeekSlider_PreviewMouseUp"
                                ValueChanged="SeekSlider_ValueChanged"/>

                        <!-- Time Stamps -->
                        <Grid Grid.Row="1" Margin="0,3,0,0">
                            <TextBlock x:Name="TxtCurrentTime" Text="0:00" FontSize="10.5" Foreground="#9CA3AF" HorizontalAlignment="Left" FontWeight="Medium"/>
                            <TextBlock x:Name="TxtTotalTime" Text="0:00" FontSize="10.5" Foreground="#9CA3AF" HorizontalAlignment="Right" FontWeight="Medium"/>
                        </Grid>
                    </Grid>

                    <!-- Playback Controls (Shuffle, Prev, Play/Pause, Stop, Next, Repeat) -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,8">
                        <!-- Shuffle Button (Realistic Toggle Style) -->
                        <Button x:Name="BtnShuffle" Style="{StaticResource RealisticToggleBtn}"
                                ToolTip="Случайный порядок (Shuffle)" Margin="0,0,10,0" Click="BtnShuffle_Click">
                            <TextBlock x:Name="TxtShuffleIcon" Text="🔀" FontSize="13" TextAlignment="Center"/>
                        </Button>

                        <!-- Previous Button -->
                        <Button x:Name="BtnPrev" Style="{StaticResource RealisticCircleBtn}"
                                ToolTip="Предыдущий трек (Ctrl+Left)" Margin="0,0,10,0" Click="BtnPrev_Click">
                            <TextBlock Text="⏮" FontSize="14" TextAlignment="Center"/>
                        </Button>

                        <!-- Big Play/Pause Button (Jewel Emerald) -->
                        <Button x:Name="BtnPlayPause" Style="{StaticResource RealisticPlayBtn}"
                                ToolTip="Воспроизведение / Пауза (Пробел)" Margin="0,0,10,0" Click="BtnPlayPause_Click">
                            <TextBlock x:Name="TxtPlayPauseIcon" Text="▶" FontSize="17" Margin="2,0,0,0" TextAlignment="Center"/>
                        </Button>

                        <!-- Stop Button -->
                        <Button x:Name="BtnStop" Style="{StaticResource RealisticCircleBtn}"
                                ToolTip="Остановить" Margin="0,0,10,0" Click="BtnStop_Click">
                            <TextBlock Text="⏹" FontSize="12" TextAlignment="Center"/>
                        </Button>

                        <!-- Next Button -->
                        <Button x:Name="BtnNext" Style="{StaticResource RealisticCircleBtn}"
                                ToolTip="Следующий трек (Ctrl+Right)" Margin="0,0,10,0" Click="BtnNext_Click">
                            <TextBlock Text="⏭" FontSize="14" TextAlignment="Center"/>
                        </Button>

                        <!-- Repeat Mode Button (Realistic Toggle Style matching Shuffle!) -->
                        <Button x:Name="BtnRepeat" Style="{StaticResource RealisticToggleBtn}"
                                ToolTip="Режим повтора: Список / Альбом / Трек / Выкл" Click="BtnRepeat_Click">
                            <TextBlock x:Name="TxtRepeatIcon" Text="🔁" FontSize="13" TextAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- Volume Control Bar (Instant jump & MouseWheel enabled) -->
                    <Grid Grid.Row="3" Margin="6,2,6,0" PreviewMouseWheel="VolumeControl_PreviewMouseWheel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <!-- Mute / Unmute Button -->
                        <Button x:Name="BtnMute" Grid.Column="0" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" ToolTip="Без звука (Mute)" Margin="0,0,8,0" Click="BtnMute_Click">
                            <TextBlock x:Name="TxtVolumeIcon" Text="🔊" FontSize="13" Foreground="#9CA3AF"/>
                        </Button>

                        <!-- Volume Slider -->
                        <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource ModernSlider}"
                                Minimum="0" Maximum="1" Value="0.7" SmallChange="0.05" LargeChange="0.1"
                                ValueChanged="VolumeSlider_ValueChanged"/>

                        <!-- Volume Percentage Label -->
                        <TextBlock x:Name="TxtVolumePercent" Grid.Column="2" Text="70%" FontSize="10.5"
                                   Foreground="#9CA3AF" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= ROW 2: PLAYLIST HEADER & SEARCH ================= -->
            <Grid Grid.Row="2" Margin="14,4,14,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search Input Box -->
                <Border Grid.Row="0" Background="#141722" CornerRadius="6" BorderBrush="#252C3C" BorderThickness="1" Margin="0,0,0,6" Height="28">
                    <Grid>
                        <TextBlock x:Name="TxtSearchPlaceholder" Text="🔍  Поиск по названию, исполнителю или альбому..." FontSize="11" Foreground="#4B5563"
                                   Margin="8,6,0,0" IsHitTestVisible="False"/>
                        <TextBox x:Name="TxtSearch" Background="Transparent" BorderThickness="0"
                                 Foreground="#F9FAFB" FontSize="11" VerticalContentAlignment="Center"
                                 Padding="8,0" TextChanged="TxtSearch_TextChanged"/>
                    </Grid>
                </Border>

                <!-- Realistic Buttons: + Файлы, + Папка, Очистить -->
                <Grid Grid.Row="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="+ Файлы" Style="{StaticResource RealisticFlatBtn}" Margin="0,0,6,0" Click="BtnAddFiles_Click"/>
                        <Button Content="+ Папка" Style="{StaticResource RealisticFlatBtn}" Margin="0,0,6,0" Click="BtnAddFolder_Click"/>
                        <Button Content="Очистить" Style="{StaticResource RealisticFlatBtn}" Click="BtnClear_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtTrackCount" Text="0 треков" FontSize="11" Foreground="#9CA3AF" FontWeight="Medium"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- ================= ROW 3: PLAYLIST LISTBOX ================= -->
            <Border Grid.Row="3" Margin="12,0,12,6" Background="#12151F" CornerRadius="8" BorderBrush="#232A3B" BorderThickness="1"
                    AllowDrop="True" Drop="Playlist_Drop" DragOver="Playlist_DragOver">
                <Grid>
                    <!-- Empty List Hint -->
                    <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                        <TextBlock Text="🎶" FontSize="34" HorizontalAlignment="Center" Opacity="0.35"/>
                        <TextBlock Text="Плейлист пуст" FontWeight="SemiBold" FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBlock Text="Перетащите аудиофайлы или папки с альбомами сюда" FontSize="11" Foreground="#4B5563" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Playlist Items -->
                    <ListBox x:Name="PlaylistListBox" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionMode="Single"
                             SelectionChanged="PlaylistListBox_SelectionChanged"
                             MouseDoubleClick="PlaylistListBox_MouseDoubleClick"
                             PreviewMouseRightButtonDown="PlaylistListBox_PreviewMouseRightButtonDown">
                        <ListBox.ContextMenu>
                            <ContextMenu Background="#151922" BorderBrush="#252D3D" Foreground="#F3F4F6">
                                <MenuItem Header="▶  Воспроизвести" Click="ContextPlay_Click" Foreground="#10B981"/>
                                <MenuItem Header="✏  Переименовать файл (F2)" Click="ContextRename_Click" Foreground="#F3F4F6"/>
                                <MenuItem Header="📂  Открыть в проводнике" Click="ContextOpenFolder_Click" Foreground="#F3F4F6"/>
                                <Separator Background="#252D3D"/>
                                <MenuItem Header="✕  Удалить из списка" Click="ContextRemove_Click" Foreground="#EF4444"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="Margin" Value="2,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#1A202E"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#242C3E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Track # or Play icon -->
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                               FontSize="11" FontWeight="Medium">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding TrackNumber}"/>
                                                <Setter Property="Foreground" Value="#6B7280"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Text" Value="▶"/>
                                                        <Setter Property="Foreground" Value="#10B981"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Title & Artist / Album -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#F3F4F6"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding DisplaySubtitle}" FontSize="10" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Duration -->
                                    <TextBlock Grid.Column="2" Text="{Binding DurationString}" FontSize="10.5" Foreground="#6B7280"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>

                                    <!-- Actions: Rename & Remove Buttons -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <!-- Rename File Button -->
                                        <Button Content="✏" FontSize="10" Width="20" Height="20" Margin="0,0,2,0"
                                                Background="Transparent" BorderThickness="0" Foreground="#6B7280"
                                                Cursor="Hand" ToolTip="Переименовать файл на диске (F2)" Click="BtnRenameTrack_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Remove Button -->
                                        <Button Content="✕" FontSize="9" Width="18" Height="18"
                                                Background="Transparent" BorderThickness="0" Foreground="#6B7280"
                                                Cursor="Hand" ToolTip="Удалить из списка (Del)" Click="BtnRemoveTrack_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ================= ROW 4: REALTIME CPU & STATUS / UPDATE BAR ================= -->
            <Grid Grid.Row="4" Margin="14,0,14,4">
                <!-- Realtime Performance & CPU Load Badge -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtPerfStats" Text="⚡ ОЗУ: ~35 МБ | ЦП: 0.0%" FontSize="10" Foreground="#10B981" FontWeight="Medium"/>
                </StackPanel>

                <!-- Status & Auto-Update Checker Badge -->
                <Button x:Name="BtnStatusUpdate" Style="{StaticResource TitleBarBtn}" Width="Auto" Height="26" Padding="6,2"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent"
                        Click="BtnStatusUpdate_Click">
                    <TextBlock x:Name="TxtStatusBarRight" Text="Проверка обновления" FontSize="10" Foreground="#9CA3AF"
                               VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- ================= RENAME FILE MODAL OVERLAY ================= -->
            <Grid x:Name="RenameModalOverlay" Grid.Row="0" Grid.RowSpan="5" Visibility="Collapsed" Panel.ZIndex="120">
                <!-- Semi-transparent backdrop -->
                <Border Background="#D907090F" MouseLeftButtonDown="RenameBackdrop_MouseLeftButtonDown"/>

                <!-- Modal Window -->
                <Border Width="400" Background="#131722" CornerRadius="12" BorderBrush="#283246" BorderThickness="1.2"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.75" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="48"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="#181E2C" CornerRadius="12,12,0,0" BorderBrush="#252F43" BorderThickness="0,0,0,1" Padding="14,0">
                            <Grid VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="✏" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#10B981"/>
                                    <TextBlock Text="Переименование файла на диске" FontWeight="Bold" FontSize="13.5" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Style="{StaticResource TitleBarBtn}" HorizontalAlignment="Right" Click="BtnCloseRename_Click" ToolTip="Закрыть (Esc)">
                                    <TextBlock Text="✕" FontSize="12" FontWeight="Bold"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Content Area -->
                        <Border Grid.Row="1" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="Файл будет переименован прямо на вашем жестком диске. Расширение защищено от изменений." FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                <TextBlock Text="Название аудиофайла:" FontSize="11" FontWeight="SemiBold" Foreground="#D1D5DB" Margin="0,0,0,6"/>

                                <!-- Input Row: Name input + Fixed locked extension badge -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#181D29" CornerRadius="6,0,0,6" BorderBrush="#2F3A50" BorderThickness="1,1,0,1" Height="32">
                                        <TextBox x:Name="TxtRenameInput" Background="Transparent" BorderThickness="0"
                                                 Foreground="#F9FAFB" FontSize="12" VerticalContentAlignment="Center"
                                                 Padding="8,0" KeyDown="TxtRenameInput_KeyDown"/>
                                    </Border>

                                    <Border Grid.Column="1" Background="#1C2436" CornerRadius="0,6,6,0" BorderBrush="#2F3A50" BorderThickness="1" Height="32" Padding="10,0">
                                        <TextBlock x:Name="TxtRenameExtension" Text=".mp3" FontWeight="Bold" FontSize="12"
                                                   Foreground="#10B981" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <TextBlock x:Name="TxtRenameError" Text="" FontSize="11" Foreground="#EF4444" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Footer Actions -->
                        <Border Grid.Row="2" Background="#161A26" CornerRadius="0,0,12,12" BorderBrush="#252D3E" BorderThickness="0,1,0,0" Padding="14,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Отмена" Style="{StaticResource RealisticFlatBtn}" Width="75" Margin="0,0,8,0" Click="BtnCloseRename_Click"/>
                                <Button Content="Сохранить" Style="{StaticResource RealisticFlatBtn}" Width="85" FontWeight="SemiBold" Click="BtnSaveRename_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= SETTINGS MODAL OVERLAY ================= -->
            <Grid x:Name="SettingsOverlay" Grid.Row="0" Grid.RowSpan="5" Visibility="Collapsed" Panel.ZIndex="100">
                <!-- Semi-transparent backdrop -->
                <Border Background="#D907090F" MouseLeftButtonDown="SettingsBackdrop_MouseLeftButtonDown"/>

                <!-- Modal Window -->
                <Border Width="400" MaxHeight="530" Background="#131722" CornerRadius="12" BorderBrush="#283246" BorderThickness="1.2"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.75" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="46"/>
                        </Grid.RowDefinitions>

                        <!-- Modal Header -->
                        <Border Grid.Row="0" Background="#181E2C" CornerRadius="12,12,0,0" BorderBrush="#252F43" BorderThickness="0,0,0,1" Padding="14,0">
                            <Grid VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚙" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#10B981"/>
                                    <TextBlock Text="Настройки" FontWeight="Bold" FontSize="13.5" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Style="{StaticResource TitleBarBtn}" HorizontalAlignment="Right" Click="BtnCloseSettings_Click" ToolTip="Закрыть (Esc)">
                                    <TextBlock Text="✕" FontSize="12" FontWeight="Bold"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Sections / Tabs Bar -->
                        <Border Grid.Row="1" Background="#10141D" BorderBrush="#1F2636" BorderThickness="0,0,0,1" Padding="12,7">
                            <StackPanel Orientation="Horizontal">
                                <!-- Controls Tab Button -->
                                <Border x:Name="TabBorderControls" Background="#1C2436" BorderBrush="#10B981" BorderThickness="1" CornerRadius="5" Padding="10,4" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="BtnTabControls_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⌨" FontSize="12" Margin="0,0,6,0" Foreground="#10B981" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtTabControls" Text="Управление" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Discord Tab Button -->
                                <Border x:Name="TabBorderDiscord" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="10,4" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="BtnTabDiscord_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎮" FontSize="12" Margin="0,0,6,0" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtTabDiscord" Text="Discord RPC" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- About Tab Button -->
                                <Border x:Name="TabBorderAbout" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="10,4" Cursor="Hand" MouseLeftButtonDown="BtnTabAbout_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ℹ" FontSize="12" Margin="0,0,6,0" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtTabAbout" Text="О программе" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Tab 1: Section Content: Управление -->
                        <ScrollViewer x:Name="TabContentControls" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,10" Visibility="Visible">
                            <StackPanel>
                                <TextBlock Text="Горячие клавиши и жесты управления" FontWeight="SemiBold" FontSize="12" Foreground="#D1D5DB" Margin="0,0,0,10"/>

                                <!-- Shortcut 1: Space -->
                                <Border Background="#171C28" BorderBrush="#222B3B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#212838" BorderBrush="#354057" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="Пробел" FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Воспроизведение / Пауза" FontSize="11.5" Foreground="#E5E7EB" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- Shortcut 2: Left / Right -->
                                <Border Background="#171C28" BorderBrush="#222B3B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Border Background="#212838" BorderBrush="#354057" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,4,0">
                                                <TextBlock Text="←" FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
                                            </Border>
                                            <Border Background="#212838" BorderBrush="#354057" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                                <TextBlock Text="→" FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="Перемотка на 5 секунд назад / вперед" FontSize="11.5" Foreground="#E5E7EB" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- Shortcut 3: Ctrl + Left / Right -->
                                <Border Background="#171C28" BorderBrush="#222B3B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#212838" BorderBrush="#354057" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="Ctrl + ← / →" FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Предыдущий / Следующий трек" FontSize="11.5" Foreground="#E5E7EB" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- Shortcut 4: Up / Down / Wheel -->
                                <Border Background="#171C28" BorderBrush="#222B3B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#212838" BorderBrush="#354057" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="↑ / ↓ / Колесо" FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Регулировка громкости" FontSize="11.5" Foreground="#E5E7EB" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- Shortcut 5: F2 Rename File -->
                                <Border Background="#171C28" BorderBrush="#222B3B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
