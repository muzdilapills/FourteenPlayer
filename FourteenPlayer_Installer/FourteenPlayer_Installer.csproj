<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FourteenPlayer_v2.1.2_Setup</AssemblyName>
    <RootNamespace>FourteenPlayer.Installer</RootNamespace>
    <Product>FourteenPlayer Setup</Product>
    <Title>FourteenPlayer_v2.1.2_Setup</Title>
    <Version>2.1.2</Version>
    <AssemblyVersion>2.1.2.0</AssemblyVersion>
    <FileVersion>2.1.2.0</FileVersion>
    <InformationalVersion>v2.1.2</InformationalVersion>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.zip">
      <LogicalName>FourteenPlayer.Installer.app.zip</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="app_icon.ico">
      <LogicalName>FourteenPlayer.Installer.app_icon.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>